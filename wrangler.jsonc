{
  "name": "property-tool",
  "compatibility_date": "2026-09-25",
  "main": "./worker-v3.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCESS_REGISTRY",
        "class_name": "AccessRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "access-v1",
      "new_sqlite_classes": ["AccessRegistry"]
    }
  ]
}
